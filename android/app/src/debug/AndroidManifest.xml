<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application>
        <!-- Debug-only typed ServiceState observer for one DUMP-gated Device Lab experiment. -->
        <provider
            android:name=".DebugTelephonyDetachProvider"
            android:authorities="${applicationId}.telephony-detach-diagnostics"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.DUMP" />

        <!-- Debug-only, no-input diagnostic endpoint. It emits typed readiness booleans only. -->
        <activity
            android:name=".DebugReadinessActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug-only, zero-input U5 acceptance trigger. It delegates exactly one request to
             the Rust-owned PRODUCT rotation operation and owns no airplane/root/timing policy. -->
        <activity
            android:name=".DebugRotationActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug-only, zero-input shutdown/restore acceptance trigger. -->
        <activity
            android:name=".DebugRuntimeStopActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug-only, zero-input restart trigger. It exercises the production Service start
             request seam without depending on MainActivity lifecycle delivery. -->
        <activity
            android:name=".DebugRuntimeStartActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
