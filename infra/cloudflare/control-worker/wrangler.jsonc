{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mish-device-control",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.alegria.by",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_CONTROL",
        "class_name": "DeviceControl"
      }
    ]
  },
  "exports": {
    "DeviceControl": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["MISH_MANAGER_TOKEN"]
  }
}
